<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="./user.css" />
    <title>Details</title>
  </head>
  <body>
    <div id="main">
      <h1>Details</h1>
      <div class="block">
        User Name:
        <span id="userName"> <%= userName %> </span>
      </div>
      <div class="block">
        StudentID:
        <span id="studentID"> <%= studentID %> </span>
      </div>
      <div class="block">
        Phone Number:
        <span id="phone"> <%= phone %> </span>
      </div>
      <div class="block">
        Email:
        <span id="email"> <%= email %> </span>
      </div>
      <div>
        <button id="logOut" type="button">登出</button>
      </div>
    </div>
    <script src="./user.js"></script>
    <% if (tarUsername != userName) { %>
    <script>
      alert('只能够访问自己的数据');
      window.location = 'http://localhost:8000?userName=' + '<%= userName %>';
    </script>
    <% } %>
  </body>
</html>
